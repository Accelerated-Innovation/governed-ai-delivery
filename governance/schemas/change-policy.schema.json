{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovKit change conformance policy v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "impact_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "impacts": {
            "type": "object",
            "properties": {
              "security": {
                "const": true
              },
              "auth": {
                "const": true
              },
              "data": {
                "const": true
              },
              "public-contract": {
                "const": true
              },
              "nfr": {
                "const": true
              },
              "ownership": {
                "const": true
              },
              "architecture": {
                "const": true
              },
              "cross-service": {
                "const": true
              },
              "llm": {
                "const": true
              },
              "mcp": {
                "const": true
              },
              "new-behavior": {
                "const": true
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "paths",
          "impacts"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "references"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 64
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        },
        "required": [
          "id",
          "argv",
          "timeout_seconds"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "forbidden_text": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "source",
          "paths",
          "forbidden_text"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "impact_rules",
    "artifacts",
    "commands",
    "constraints"
  ],
  "additionalProperties": false
}
