{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovKit change conformance policy v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "impact_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "impacts": {
            "type": "object",
            "properties": {
              "security": {
                "const": true
              },
              "auth": {
                "const": true
              },
              "data": {
                "const": true
              },
              "public-contract": {
                "const": true
              },
              "nfr": {
                "const": true
              },
              "ownership": {
                "const": true
              },
              "architecture": {
                "const": true
              },
              "cross-service": {
                "const": true
              },
              "llm": {
                "const": true
              },
              "mcp": {
                "const": true
              },
              "new-behavior": {
                "const": true
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "paths",
          "impacts"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "references"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 64
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        },
        "required": [
          "id",
          "argv",
          "timeout_seconds"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "forbidden_text": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "source",
          "paths",
          "forbidden_text"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "observation_limits": {
      "type": "object",
      "properties": {
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      },
      "additionalProperties": false
    },
    "protected": {
      "description": "Optional. What a change may not weaken, checked by `change:protected`. Paths are literal and relative to the repository root; a folder covers every file under it.",
      "type": "object",
      "properties": {
        "tests": {
          "description": "Test files and folders. A new file passes. An existing file may only gain lines.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "files": {
          "description": "Test support, settings, CI workflows and other files. A new file passes. An existing file may not change. A path also under `tests` follows this rule.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "escape_markers": {
          "description": "Literal text that takes a test out of the run, such as a skip marker. Its count in the files under `tests` and in feature definitions may not rise.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "impact_rules",
    "artifacts",
    "commands",
    "constraints"
  ],
  "additionalProperties": false
}
