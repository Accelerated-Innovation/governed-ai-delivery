{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovKit portable pack lock v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "pack-lock"
    },
    "govkit_version": {
      "type": "string",
      "minLength": 1
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "type": "object"
    },
    "agent": {
      "enum": [
        null,
        "codex",
        "copilot",
        "claude-code"
      ]
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "bundled",
              "local"
            ]
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "legacy": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "digest",
          "version",
          "source",
          "provides",
          "legacy"
        ],
        "additionalProperties": false
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "object"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "execution": {
      "const": "not-run"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parent": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "parent",
          "capability",
          "provider",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "govkit_version",
    "profile_digest",
    "profile",
    "agent",
    "packs",
    "required_checks",
    "checks",
    "files",
    "owners",
    "execution",
    "edges"
  ],
  "additionalProperties": false
}
