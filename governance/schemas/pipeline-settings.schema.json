{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pipeline-settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "govkit_version",
    "execute_checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "govkit_version": {
      "type": "string",
      "minLength": 1
    },
    "execute_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true,
      "maxItems": 128
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "target_ref",
        "allow_forks"
      ],
      "properties": {
        "provider": {
          "enum": [
            "github",
            "azure"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target_ref": {
          "type": "string",
          "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9/_.-]*$",
          "maxLength": 256
        },
        "allow_forks": {
          "type": "boolean"
        }
      }
    }
  }
}
