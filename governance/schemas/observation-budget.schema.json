{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "limits": {
      "type": "object",
      "properties": {
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "max_files": {
          "const": 2048
        },
        "max_total_bytes": {
          "const": 16777216
        },
        "max_changed_paths": {
          "const": 256
        }
      },
      "required": [
        "max_file_bytes",
        "max_files",
        "max_total_bytes",
        "max_changed_paths"
      ],
      "additionalProperties": false
    },
    "source_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_state": {
      "enum": [
        "accepted",
        "default",
        "unavailable"
      ]
    }
  },
  "required": [
    "limits",
    "source_digest",
    "source_state"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source_state": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "source_digest": {
            "type": "null"
          },
          "limits": {
            "properties": {
              "max_file_bytes": {
                "const": 1048576
              }
            }
          }
        }
      }
    }
  ]
}
