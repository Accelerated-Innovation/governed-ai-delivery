{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Accelerated-Innovation/governed-ai-delivery/blob/main/governance/schemas/resolution.schema.json",
  "title": "GovKit profile resolution record v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "profile-resolution"
    },
    "govkit_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "enum": [
          "agent",
          "ci",
          "project_type",
          "stack"
        ]
      },
      "uniqueItems": true
    },
    "release_metadata_status": {
      "const": "not-queried"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "govkit_version",
    "profile_digest",
    "profile",
    "plan",
    "unknowns",
    "release_metadata_status"
  ],
  "additionalProperties": false,
  "$defs": {
    "acceptedSource": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "authority": {
          "enum": [
            "accepted"
          ]
        }
      },
      "required": [
        "reference",
        "authority"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "source",
        "scope"
      ],
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "source",
        "scope",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "retain",
            "improve",
            "migrate"
          ]
        },
        "current": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          },
          "minItems": 1
        },
        "target": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "applies_to": {
          "enum": [
            "new",
            "new-and-changed",
            "all"
          ]
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception"
          }
        }
      },
      "required": [
        "id",
        "source",
        "scope",
        "mode",
        "current",
        "target",
        "applies_to"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "improve",
                  "migrate"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "retain"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "additional_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "source",
        "when"
      ],
      "additionalProperties": false
    },
    "releaseSource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "url",
        "channels"
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "pin": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "compatibility": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "component",
        "source_id",
        "channel"
      ],
      "additionalProperties": false
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/releaseSource"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "metadata_max_age_hours": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "assessment_max_age_hours": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "allow_refresh": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "profileCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "requires_context": {
          "type": "array",
          "items": {
            "enum": [
              "agent",
              "ci",
              "project_type",
              "stack"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "policyCheck": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "capability_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "profilePolicy": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "required_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policyCheck"
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workflow"
          }
        },
        "conformance": {
          "$ref": "#/$defs/acceptedSource"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "repository": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "project_type": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stack": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "integrations": {
          "type": "object",
          "properties": {
            "agent": {
              "enum": [
                null,
                "codex",
                "copilot",
                "claude-code"
              ]
            },
            "ci": {
              "enum": [
                null,
                "github",
                "azure"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profileCapability"
          }
        },
        "policy": {
          "$ref": "#/$defs/profilePolicy"
        },
        "maintenance": {
          "$ref": "#/$defs/maintenance"
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source": {
                "enum": [
                  "bundled",
                  "local"
                ]
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "source"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source": {
                      "const": "local"
                    }
                  }
                },
                "then": {
                  "required": [
                    "digest"
                  ]
                }
              }
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "source",
        "repository",
        "capabilities",
        "policy"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "authority": {
          "enum": [
            "observed",
            "proposed",
            "accepted",
            "bundled",
            "legacy"
          ]
        }
      },
      "required": [
        "reference",
        "authority"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "text",
        "source"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          },
          "minItems": 1
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "reasons",
        "requires",
        "conflicts"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "ownership": {
          "enum": [
            "agent-config",
            "project-artifact",
            "governed-contract"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          },
          "minItems": 1
        },
        "capability_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "attributes": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "source_path",
        "destination",
        "ownership",
        "reasons",
        "capability_id",
        "attributes"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          },
          "minItems": 1
        },
        "capability_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "reasons",
        "capability_id"
      ],
      "additionalProperties": false
    },
    "unresolved": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "affected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      },
      "required": [
        "id",
        "code",
        "affected",
        "message",
        "reasons"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "authority": {
              "const": "observed"
            }
          },
          "required": [
            "reference",
            "authority"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "unknown",
            "partial",
            "confirmed"
          ]
        }
      },
      "required": [
        "source",
        "summary",
        "scope",
        "confidence"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "authority": {
              "const": "proposed"
            }
          },
          "required": [
            "reference",
            "authority"
          ],
          "additionalProperties": false
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "source",
        "question",
        "scope"
      ],
      "additionalProperties": false
    },
    "planPolicy": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "required_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        }
      },
      "required": [
        "source",
        "required_checks",
        "contracts",
        "transitions"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "source",
        "digest",
        "details"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "const": "installation"
        },
        "repository_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "selections": {
          "type": "object",
          "properties": {
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/capability"
              }
            },
            "artifacts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/artifact"
              }
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/check"
              }
            },
            "unresolved": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/unresolved"
              }
            }
          },
          "required": [
            "capabilities",
            "artifacts",
            "checks",
            "unresolved"
          ],
          "additionalProperties": false
        },
        "integrations": {
          "type": "object",
          "properties": {
            "agent": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "project_type": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ci": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stack": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "agent",
            "project_type",
            "ci",
            "stack"
          ],
          "additionalProperties": false
        },
        "policy": {
          "$ref": "#/$defs/planPolicy"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "proposals": {
          "type": "array",
