{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovKit bounded discovery and rediscovery v1",
  "type": "object",
  "properties": {
    "kind": {
      "const": "discovery"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scanner_version": {
      "type": "integer",
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "profile_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "accepted_profile": {
      "type": [
        "object",
        "null"
      ]
    },
    "proposed_profile": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": 1
            },
            "source": {
              "type": "object",
              "properties": {
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "authority": {
                  "enum": [
                    "proposed"
                  ]
                }
              },
              "required": [
                "reference",
                "authority"
              ],
              "additionalProperties": false
            },
            "repository": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              }
            },
            "policy": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "object",
                  "properties": {
                    "reference": {
                      "type": "string",
                      "minLength": 1
                    },
                    "authority": {
                      "enum": [
                        "proposed"
                      ]
                    }
                  },
                  "required": [
                    "reference",
                    "authority"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schema_version",
            "source",
            "repository",
            "capabilities",
            "policy"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "manifest",
              "architecture",
              "decision",
              "guidance",
              "documentation",
              "reference",
              "code",
              "test",
              "ci",
              "inventory"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "observed",
              "unavailable",
              "missing",
              "limited"
            ]
          },
          "digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "source",
          "category",
          "scope",
          "status",
          "digest",
          "confidence",
          "signals"
        ],
        "additionalProperties": false
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_entries": {
              "type": "integer",
              "minimum": 1
            },
            "max_files": {
              "type": "integer",
              "minimum": 1
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "max_total_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_entries",
            "max_files",
            "max_bytes",
            "max_total_bytes",
            "max_depth"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "complete",
        "limitations",
        "limits"
      ],
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "accepted",
              "review-required"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "scope",
          "status",
          "reason",
          "sources",
          "choices",
          "affects"
        ],
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "added",
              "changed",
              "removed",
              "unavailable"
            ]
          },
          "before_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "after_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source",
          "scope",
          "category",
          "kind",
          "before_digest",
          "after_digest"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "accepted",
              "review-required"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "scope",
          "status",
          "reason",
          "sources",
          "choices",
          "affects"
        ],
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "create",
              "preserve",
              "update",
              "protected",
              "remove"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "before_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "proposed_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "action",
          "before_digest",
          "proposed_digest"
        ],
        "additionalProperties": false
      }
    },
    "install_ready": {
      "type": "boolean"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "kind",
    "schema_version",
    "scanner_version",
    "repository",
    "profile_digest",
    "accepted_profile",
    "proposed_profile",
    "observations",
    "boundaries",
    "coverage",
    "decisions",
    "changes",
    "review",
    "operations",
    "install_ready",
    "references"
  ],
  "additionalProperties": false
}
