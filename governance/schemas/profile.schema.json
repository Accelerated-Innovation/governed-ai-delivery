{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Accelerated-Innovation/governed-ai-delivery/blob/main/governance/schemas/profile.schema.json",
  "title": "GovKit desired project profile v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source": {
      "$ref": "#/$defs/acceptedSource"
    },
    "repository": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "project_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "stack": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "properties": {
        "agent": {
          "enum": [
            null,
            "codex",
            "copilot",
            "claude-code"
          ]
        },
        "ci": {
          "enum": [
            null,
            "github",
            "azure"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profileCapability"
      }
    },
    "policy": {
      "$ref": "#/$defs/profilePolicy"
    },
    "maintenance": {
      "$ref": "#/$defs/maintenance"
    }
  },
  "required": [
    "schema_version",
    "source",
    "repository",
    "capabilities",
    "policy"
  ],
  "additionalProperties": false,
  "$defs": {
    "acceptedSource": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "authority": {
          "enum": [
            "accepted"
          ]
        }
      },
      "required": [
        "reference",
        "authority"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "source",
        "scope"
      ],
      "additionalProperties": false
    },
    "exception": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "source",
        "scope",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "retain",
            "improve",
            "migrate"
          ]
        },
        "current": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          },
          "minItems": 1
        },
        "target": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "applies_to": {
          "enum": [
            "new",
            "new-and-changed",
            "all"
          ]
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception"
          }
        }
      },
      "required": [
        "id",
        "source",
        "scope",
        "mode",
        "current",
        "target",
        "applies_to"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "improve",
                  "migrate"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "retain"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "workflow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "additional_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "source",
        "when"
      ],
      "additionalProperties": false
    },
    "releaseSource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "url",
        "channels"
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "pin": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "compatibility": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "component",
        "source_id",
        "channel"
      ],
      "additionalProperties": false
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/releaseSource"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "metadata_max_age_hours": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "assessment_max_age_hours": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "allow_refresh": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "profileCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "requires_context": {
          "type": "array",
          "items": {
            "enum": [
              "agent",
              "ci",
              "project_type",
              "stack"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "policyCheck": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "capability_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "profilePolicy": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/acceptedSource"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "required_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policyCheck"
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contract"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workflow"
          }
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    }
  }
}
