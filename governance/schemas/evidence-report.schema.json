{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:governed-ai-delivery:schemas:evidence-report",
  "title": "Feature evidence report",
  "description": "What `govkit evidence --feature` found for one feature: each scenario in `acceptance.feature` with the test results bound to it, and each criterion in `eval_criteria.yaml` with the measured scores compared with it. A valid report is well-formed. It does not authenticate where its results came from. Its `provenance` says whether an evidence record ties them to the current commit and working tree.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "feature",
    "outcome",
    "detail",
    "summary",
    "sources",
    "results",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "govkit.evidence-report"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "definition",
        "content_digest",
        "criteria"
      ],
      "properties": {
        "name": {
          "description": "The feature directory name. It is the package in every requirement identifier.",
          "type": "string",
          "maxLength": 1000
        },
        "definition": {
          "description": "Path of the feature file, relative to the target.",
          "type": "string",
          "maxLength": 1000
        },
        "content_digest": {
          "description": "SHA-256 of the feature file's bytes, or null when it was not read.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition",
            "content_digest",
            "form"
          ],
          "properties": {
            "definition": {
              "description": "Path of the criteria file, relative to the target.",
              "type": "string",
              "maxLength": 1000
            },
            "content_digest": {
              "description": "SHA-256 of the criteria file's bytes, or null when it was not read. It is the revision of every criterion.",
              "oneOf": [
                {
                  "$ref": "#/$defs/digest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "form": {
              "description": "`absent` when the feature has no criteria file; `named` when its criteria carry a name and are compared; `data` when they are in the data form, which is not compared and prevents PASS.",
              "enum": [
                "absent",
                "named",
                "data"
              ]
            }
          }
        }
      }
    },
    "outcome": {
      "description": "The feature's Working outcome. PASS only when every scenario and every criterion passed.",
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "ERROR"
      ]
    },
    "detail": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarios",
        "criteria",
        "passed",
        "failed",
        "error",
        "skipped",
        "missing",
        "owed"
      ],
      "properties": {
        "scenarios": {
          "type": "integer",
          "minimum": 0
        },
        "criteria": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "owed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/source"
          },
          {
            "$ref": "#/$defs/results_file"
          }
        ]
      }
    },
    "results": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/result"
          },
          {
            "$ref": "#/$defs/evaluation"
          }
        ]
      }
    },
    "provenance": {
      "description": "Whether the result files belong to the repository as it is now, according to the evidence record. Results count only when the state is `current`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "detail",
        "commit",
        "tree_digest",
        "recorded_at"
      ],
      "properties": {
        "state": {
          "description": "`current`: the commit, the working tree and the result files are as recorded. `stale`: one of them changed. `unrecorded`: there is no record. `unavailable`: the record or the working tree could not be read. `not-checked`: no result file was read.",
          "enum": [
            "current",
            "stale",
            "unrecorded",
            "unavailable",
            "not-checked"
          ]
        },
        "detail": {
          "type": "string"
        },
        "commit": {
          "description": "The recorded commit, or null without a record.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "tree_digest": {
          "description": "The recorded working tree digest, or null without a record.",
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at": {
          "description": "When the record was written, in UTC, or null without a record.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "path",
        "content_digest",
        "unidentified_skipped"
      ],
      "properties": {
        "tool": {
          "const": "junit"
        },
        "path": {
          "description": "Path of the result file, relative to the target.",
          "type": "string"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "unidentified_skipped": {
          "description": "Skipped tests the file counts but does not mark. When it is not zero the outcome cannot be PASS.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "revision_digest",
        "kind",
        "title",
        "id_source",
        "tags",
        "outcome",
        "binding",
        "tests"
      ],
      "properties": {
        "requirement_id": {
          "description": "`<feature directory>#scenario:<slug>`, as the Product Definition Graph identifies the scenario.",
          "type": "string",
          "pattern": "^[^#]+#scenario:[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "revision_digest": {
          "description": "SHA-256 of the scenario's normalised text, as the Product Definition Graph computes it.",
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "const": "test"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "id_source": {
          "description": "`tag` when the scenario carries `@scenario:<slug>`; `derived` when the slug comes from the title and changes when the title does.",
          "enum": [
            "tag",
            "derived"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome": {
          "description": "The worst of the bound tests, or `missing` when none was found.",
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped",
            "missing"
          ]
        },
        "binding": {
          "description": "How the tests were matched: `id` and `tag` from a `govkit.scenario` property, `title` from the test name, `none` when nothing matched. Only `id` is exact across features.",
          "enum": [
            "id",
            "tag",
            "title",
            "none"
          ]
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "classname",
        "outcome",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "classname": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped"
          ]
        },
        "source": {
          "description": "The `path` of the source the test case was read from.",
          "type": "string"
        }
      }
    },
    "results_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "path",
        "content_digest"
      ],
      "properties": {
        "tool": {
          "const": "evaluation-results"
        },
        "path": {
          "description": "Path of the evaluation results file, relative to the target.",
          "type": "string"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "revision_digest",
        "kind",
        "title",
        "tags",
        "outcome",
        "execution_class",
        "compared_with",
        "measurements"
      ],
      "properties": {
        "requirement_id": {
          "description": "`<feature directory>#evaluation:<criterion name>`, as the Product Definition Graph identifies the criterion.",
          "type": "string",
          "pattern": "^[^#]+#evaluation:.+$"
        },
        "revision_digest": {
          "description": "SHA-256 of the criteria file's bytes.",
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "const": "evaluation"
        },
        "title": {
          "description": "The criterion's name.",
          "type": "string",
          "maxLength": 200
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome": {
          "description": "The worst of the measurements. With none, `missing` for a free criterion and `owed` for a paid or human one.",
          "enum": [
            "passed",
            "failed",
            "error",
            "missing",
            "owed"
          ]
        },
        "execution_class": {
          "description": "Who may run the criterion. GovKit starts none of them.",
          "enum": [
            "free",
            "paid",
            "human"
          ]
        },
        "compared_with": {
          "description": "What a measurement was compared with: the target when the criterion declares one, otherwise its threshold, otherwise null.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target"
              ],
              "properties": {
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "metric",
                    "comparator",
                    "value",
                    "value_high",
                    "unit"
                  ],
                  "properties": {
                    "metric": {
                      "type": "string"
                    },
                    "comparator": {
                      "enum": [
                        ">=",
                        "<=",
                        "==",
                        "between"
                      ]
                    },
                    "value": {
                      "type": "number"
                    },
                    "value_high": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "unit": {
                      "enum": [
                        "seconds",
                        "minutes",
                        "hours",
                        "days",
                        "percent",
                        "ratio",
                        "count",
                        "currency"
                      ]
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "threshold",
                "fail_on"
              ],
              "properties": {
                "threshold": {
                  "type": "number"
                },
                "fail_on": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measurement"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "metric",
        "n",
        "met",
        "source"
      ],
      "properties": {
        "value": {
          "description": "The measured value, or null when the evaluation errored.",
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "oneOf": [
            {
              "enum": [
                "seconds",
                "minutes",
                "hours",
                "days",
                "percent",
                "ratio",
                "count",
                "currency"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "metric": {
          "type": [
            "string",
            "null"
          ]
        },
        "n": {
          "description": "Sample size, when the results file gave one.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "met": {
          "description": "Whether the value satisfied what it was compared with. Null when it was not compared.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "description": "The `path` of the source the measurement was read from.",
          "type": "string"
        }
      }
    }
  }
}
