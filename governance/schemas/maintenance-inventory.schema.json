{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Version and resource inventory",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "kind": {
      "const": "maintenance-inventory"
    },
    "target": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "identity": {
      "type": "object",
      "properties": {
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_complete": {
          "type": "boolean"
        },
        "profile_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "pack_lock_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observation_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "revision",
        "dirty_digest",
        "git_complete",
        "profile_digest",
        "resolution_digest",
        "pack_lock_digest",
        "input_digest"
      ],
      "additionalProperties": false
    },
    "running_cli": {
      "type": "string"
    },
    "python_version": {
      "type": "string"
    },
    "recorded_install": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_govkit": {
      "type": [
        "string",
        "null"
      ]
    },
    "locked_packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "bundled",
              "local"
            ]
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "legacy": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "digest",
          "version",
          "source",
          "provides",
          "legacy"
        ],
        "additionalProperties": false
      }
    },
    "lock_verification": {
      "enum": [
        "verified",
        "unverified",
        "unknown"
      ]
    },
    "resources": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "actual_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "matching",
              "missing",
              "modified",
              "unavailable"
            ]
          },
          "action": {
            "enum": [
              "none",
              "refresh-resources",
              "reconcile-customizations",
              "inspect-resources"
            ]
          }
        },
        "required": [
          "path",
          "owner",
          "expected_digest",
          "actual_digest",
          "state",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string"
          },
          "installed": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "pin": {
            "type": [
              "string",
              "null"
            ]
          },
          "compatibility": {
            "type": [
              "string",
              "null"
            ]
          },
          "newest_known": {
            "type": [
              "string",
              "null"
            ]
          },
          "compatible_candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string"
                },
                "channel": {
                  "type": "string"
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "version",
                "channel",
                "reasons"
              ],
              "additionalProperties": false
            }
          },
          "selected_target": {
            "type": [
              "string",
              "null"
            ]
          },
          "current_policy_state": {
            "enum": [
              "unknown",
              "compliant",
              "outside-policy"
            ]
          },
          "freshness": {
            "enum": [
              "fresh",
              "stale",
              "unknown"
            ]
          },
          "age_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "lookup_status": {
            "enum": [
              "bundled",
              "cached",
              "refreshed",
              "failed",
              "unavailable"
            ]
          },
          "as_of": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "latest_verified": {
            "const": false
          }
        },
        "required": [
          "component",
          "installed",
          "source_id",
          "source_url",
          "channel",
          "pin",
          "compatibility",
          "newest_known",
          "compatible_candidates",
          "excluded",
          "selected_target",
          "current_policy_state",
          "freshness",
          "age_hours",
          "lookup_status",
          "as_of",
          "retrieved_at",
          "latest_verified"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "kind": {
            "const": "release-metadata"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "as_of": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lookup_status": {
            "enum": [
              "bundled",
              "cached",
              "refreshed",
              "failed",
              "unavailable"
            ]
          },
          "releases": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "object",
              "properties": {
                "component": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "channel": {
                  "type": "string",
                  "minLength": 1
                },
                "requires_govkit": {
                  "type": "string"
                },
                "requires_python": {
                  "type": "string"
                },
                "dependencies": {
                  "type": "object",
                  "maxProperties": 100,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "component",
                "version",
                "channel",
                "requires_govkit",
                "requires_python",
                "dependencies"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schema_version",
          "kind",
          "source_id",
          "source_url",
          "as_of",
          "retrieved_at",
          "lookup_status",
          "releases"
        ],
        "additionalProperties": false
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_resolution": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "govkit_version": {
              "type": "string"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "govkit_version",
            "capabilities"
          ],
          "additionalProperties": false
        }
      ]
    },
    "observation": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "max_file_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            },
            "max_files": {
              "const": 2048
            },
            "max_total_bytes": {
              "const": 16777216
            },
            "max_changed_paths": {
              "const": 256
            }
          },
          "required": [
            "max_file_bytes",
            "max_files",
            "max_total_bytes",
            "max_changed_paths"
          ],
          "additionalProperties": false
        },
        "source_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_state": {
          "enum": [
            "accepted",
            "default",
            "unavailable"
          ]
        }
      },
      "required": [
        "limits",
        "source_digest",
        "source_state"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_state": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "source_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "source_digest": {
                "type": "null"
              },
              "limits": {
                "properties": {
                  "max_file_bytes": {
                    "const": 1048576
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "target",
    "repository",
    "as_of",
    "identity",
    "running_cli",
    "python_version",
    "recorded_install",
    "resolved_govkit",
    "locked_packs",
    "lock_verification",
    "resources",
    "candidates",
    "metadata",
    "problems",
    "limitations",
    "digest",
    "profile_resolution"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "observation"
        ]
      },
      "else": {
        "not": {
          "required": [
            "observation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "identity": {
            "required": [
              "observation_digest"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "identity": {
            "not": {
              "required": [
                "observation_digest"
              ]
            }
          }
        }
      }
    }
  ]
}
