{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:governed-ai-delivery:schemas:extension-inventory",
  "title": "Installed extension inventory",
  "description": "Output of `govkit extension list --installed --json`: legacy and declarative installs with repository-relative resources and conflicting copies. Installed guidance is not accepted project policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "lock", "ready", "extensions", "conflicts", "limitations"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "extension-inventory" },
    "lock": { "enum": ["absent", "verified", "unverified"] },
    "ready": { "type": "boolean" },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "source", "root", "status", "contract_sets", "resources", "issues"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": ["string", "null"] },
          "source": { "enum": ["legacy", "declarative"] },
          "root": { "type": "string", "minLength": 1 },
          "status": { "enum": ["valid", "invalid", "verified", "unverified"] },
          "contract_sets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "capabilities", "applies_to", "paths"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "capabilities": { "type": "array", "items": { "type": "string" } },
                "applies_to": { "type": "array", "items": { "type": "string" } },
                "paths": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "resources": { "type": "array", "items": { "type": "string" } },
          "issues": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "extension", "roots", "message"],
        "properties": {
          "kind": { "enum": ["legacy-and-declarative", "orphan-pack-directory"] },
          "extension": { "type": "string", "minLength": 1 },
          "roots": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
