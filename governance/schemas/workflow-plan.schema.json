{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovKit workflow-plan v1",
  "type": "object",
  "properties": {
    "kind": {
      "const": "request-plan"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "resolver_version": {
      "type": "integer",
      "const": 1
    },
    "identity": {
      "type": "object",
      "properties": {
        "profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lock_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "profile_digest",
        "request_digest",
        "lock_digest",
        "scope_digest",
        "plan_digest"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "enum": [
        "defect",
        "bounded",
        "full-feature",
        "architecture"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "\\S"
      },
      "minItems": 1,
      "maxItems": 320
    },
    "impacts": {
      "type": "object",
      "properties": {
        "bounded": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "within-contracts": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "new-behavior": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "security": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "auth": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "data": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "public-contract": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "nfr": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ownership": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "architecture": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cross-service": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "llm": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mcp": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "bounded",
        "within-contracts",
        "new-behavior",
        "security",
        "auth",
        "data",
        "public-contract",
        "nfr",
        "ownership",
        "architecture",
        "cross-service",
        "llm",
        "mcp"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "object"
        },
        "request": {
          "type": "object"
        },
        "context": {
          "type": "object"
        },
        "observed_scope": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "schema_version": {
                  "type": "integer",
                  "const": 1
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                  },
                  "minItems": 0,
                  "maxItems": 256
                },
                "impacts": {
                  "type": "object",
                  "properties": {
                    "bounded": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "within-contracts": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "new-behavior": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "security": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "auth": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "data": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "public-contract": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "nfr": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "ownership": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "architecture": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "cross-service": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "llm": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "mcp": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "schema_version",
                "paths",
                "impacts"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "previous": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "identity": {
                  "type": "object",
                  "properties": {
                    "profile_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "request_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "lock_digest": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "scope_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "plan_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "profile_digest",
                    "request_digest",
                    "lock_digest",
                    "scope_digest",
                    "plan_digest"
                  ],
                  "additionalProperties": false
                },
                "workflow": {
                  "enum": [
                    "defect",
                    "bounded",
                    "full-feature",
                    "architecture"
                  ]
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                  },
                  "minItems": 0,
                  "maxItems": 256
                }
              },
              "required": [
                "identity",
                "workflow",
                "checks"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "profile",
        "request",
        "context",
        "observed_scope",
        "previous"
      ],
      "additionalProperties": false
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "required": {
            "const": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "source_policy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 320
          },
          "execution": {
            "const": "not-run"
          }
        },
        "required": [
          "id",
          "required",
          "reason",
          "source_policy",
          "scope",
          "execution"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 256
          }
        },
        "required": [
          "id",
          "path",
          "digest",
          "capabilities"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 256
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "origin": {
            "enum": [
              "local-check",
              "unverified"
            ]
          },
          "digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 256
          }
        },
        "required": [
          "source",
          "scope",
          "method",
          "origin",
          "digest",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "reused_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "authority": {
                "const": "accepted"
              }
            },
            "required": [
              "reference",
              "authority"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 256
          }
        },
        "required": [
          "source",
          "scope"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "affected": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "affected",
          "blocking"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "reassessment": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "previous_identity": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "added_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "required",
        "previous_identity",
        "reasons",
        "added_checks"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 256
    }
  },
  "required": [
    "kind",
    "schema_version",
    "resolver_version",
    "identity",
    "workflow",
    "scope",
    "impacts",
    "inputs",
    "required_capabilities",
    "checks",
    "artifacts",
    "guidance",
    "evidence",
    "reused_contracts",
    "decisions",
    "reassessment",
    "limitations"
  ],
  "additionalProperties": false
}
