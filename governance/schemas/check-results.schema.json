{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovKit check results v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "check-results"
    },
    "govkit_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "identity": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pack_lock_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "change_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repository",
        "revision",
        "dirty_digest",
        "profile_digest",
        "resolution_digest",
        "pack_lock_digest",
        "change_digest",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "not-applicable": {
          "type": "integer",
          "minimum": 0
        },
        "waived": {
          "type": "integer",
          "minimum": 0
        },
        "required": {
          "type": "integer",
          "minimum": 0
        },
        "required_satisfied": {
          "type": "integer",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "pass",
        "fail",
        "warn",
        "unknown",
        "skipped",
        "not-applicable",
        "waived",
        "required",
        "required_satisfied",
        "executed"
      ],
      "additionalProperties": false
    },
    "state": {
      "enum": [
        "pass",
        "fail",
        "warn",
        "unknown",
        "skipped",
        "not-applicable",
        "waived"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "govkit_version",
    "identity",
    "results",
    "summary",
    "state",
    "exit_code",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "origin": {
          "enum": [
            "local-check",
            "tool-execution",
            "unverified-artifact",
            "agent-assertion"
          ]
        },
        "digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        }
      },
      "required": [
        "source",
        "scope",
        "method",
        "origin",
        "digest",
        "limitations"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^finding:[0-9a-f]{64}$"
        },
        "check_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "suggested_action": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "applicability_reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "check_id",
        "code",
        "severity",
        "category",
        "message",
        "suggested_action",
        "location",
        "evidence",
        "applicability_reason",
        "source_policy",
        "scope"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "state": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "unknown",
            "skipped",
            "not-applicable",
            "waived"
          ]
        },
        "execution": {
          "enum": [
            "not-run",
            "executed",
            "error"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "required",
        "reason",
        "source_policy",
        "scope",
        "state",
        "execution",
        "summary",
        "evidence",
        "findings"
      ],
      "additionalProperties": false
    }
  }
}
