{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:governed-ai-delivery:schemas:eval_criteria",
  "title": "Eval Criteria Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Schema version for the eval_criteria.yaml instance.",
      "minimum": 1
    },
    "mode": {
      "type": "string",
      "description": "Controls whether CI runs LLM evals, deterministic checks, or skips eval execution.",
      "enum": ["llm", "deterministic", "none"]
    },
    "rationale": {
      "type": "string",
      "description": "Required when mode is none. Explains why evaluation execution is not applicable."
    },
    "feature": {
      "type": "string",
      "description": "Optional. The feature name this eval_criteria.yaml belongs to."
    },
    "owner": {
      "type": "string",
      "description": "Optional. Team or role responsible for keeping criteria accurate."
    },

    "unit_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforce_FIRST", "minimum_FIRST_average"],
      "properties": {
        "enforce_FIRST": { "type": "boolean" },
        "minimum_FIRST_average": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },

    "code_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforce_virtues", "minimum_virtue_average"],
      "properties": {
        "enforce_virtues": { "type": "boolean" },
        "minimum_virtue_average": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },

    "llm_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria"],
      "properties": {
        "criteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/criterion" }
        },
        "dataset": {
          "type": "string",
          "description": "Path or identifier for the eval dataset/prompt set."
        },
        "fail_on_regression": {
          "type": "boolean",
          "default": true
        }
      }
    },

    "criteria": {
      "type": "array",
      "description": "Legacy: prefer llm_evaluation.criteria. Retained for compatibility.",
      "items": { "$ref": "#/$defs/criterion" }
    },

    "multi_agent": {
      "type": "boolean",
      "description": "Multi-agent topology trigger. When true, govkit validate and the multi-agent CI gate require agent_topology.md. Skill-oriented agent architecture applicability does not depend on this flag."
    },

    "multi_agent_evaluation": {
      "type": "object",
      "description": "Multi-agent governance criteria. Allowed only with multi_agent: true. Scores stay null until evaluated.",
      "additionalProperties": false,
      "required": ["topology_validated", "system_prompt_governed"],
      "properties": {
        "topology_validated": {
          "type": "boolean",
          "description": "agent_topology.md was reviewed and approved before implementation."
        },
        "system_prompt_governed": {
          "type": "boolean",
          "description": "All agent system prompts are file-based and declared in agent_topology.md."
        },
        "cross_agent_coherence": { "$ref": "#/$defs/multi_agent_score" },
        "orchestrator_routing_accuracy": { "$ref": "#/$defs/multi_agent_score" }
      }
    }
  },

  "allOf": [
    {
      "if": { "required": ["multi_agent_evaluation"] },
      "then": {
        "required": ["multi_agent"],
        "properties": { "multi_agent": { "const": true } }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "none" } },
        "required": ["mode"]
      },
      "then": {
        "required": ["rationale"],
        "properties": {
          "criteria": { "maxItems": 0 },
          "llm_evaluation": false
        }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "llm" } },
        "required": ["mode"]
      },
      "then": {
        "required": ["unit_tests", "code_quality", "llm_evaluation"]
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "deterministic" } },
        "required": ["mode"]
      },
      "then": {
        "required": ["unit_tests", "code_quality"]
      }
    }
  ],

  "$defs": {
    "multi_agent_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "evidence"],
      "properties": {
        "score": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 5,
          "description": "Null until evaluated; the plan's evaluation_prediction carries the forecast."
        },
        "evidence": { "type": "string" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "eval_class", "threshold", "fail_on"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": { "type": "string" },
        "expected_behavior": { "type": "string" },
        "eval_class": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "retrieval_match",
            "safety_classifier",
            "structure_validator",
            "tone_classifier",
            "factual_accuracy",
            "custom",
            "deepeval_faithfulness",
            "deepeval_answer_relevancy",
            "deepeval_hallucination",
            "deepeval_contextual_relevancy",
            "deepeval_geval",
            "promptfoo_adversarial",
            "promptfoo_regression",
            "ragas_context_recall",
            "ragas_faithfulness",
            "ragas_answer_relevancy",
            "ragas_context_precision"
          ],
          "description": "Evaluation class. Standard classes cover deterministic checks. L5 classes (deepeval_*, promptfoo_*, ragas_*) map to specific tool metrics. Use 'custom' for project-specific eval types."
        },
        "tool": {
          "type": "string",
          "enum": ["deepeval", "promptfoo", "ragas", "custom"],
          "description": "Optional. Evaluation tool that executes this criterion. Inferred from eval_class prefix if omitted."
        },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "fail_on": {
          "type": "string",
          "enum": ["below_threshold", "above_threshold", "error", "missing_signal"]
        },
        "weight": { "type": "number", "minimum": 0 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}